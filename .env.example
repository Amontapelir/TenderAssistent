# Скопируйте в .env (в корне проекта) и впишите значения. .env в git не попадает.
# Ключ DaMIA (API-Закупки). Тариф «API-Старт»: по 100 запросов на метод на весь год.
DAMIA_KEY=

# Языковая модель: любой сервис с интерфейсом как у OpenAI (Groq, Mistral и др.).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Необязательно. Для рассуждающих моделей: low, medium или high. Меньше — дешевле и быстрее.
LLM_REASONING_EFFORT=
# Необязательно. ИНН компании, для которой подбираются закупки.
COMPANY_INN=
